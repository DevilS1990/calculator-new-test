import java.util.Scanner;

public class SimpleCalculator {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.println("Ввод: число знак число или '000' для выхода:");
            String input = scanner.nextLine().trim();

            if (input.equalsIgnoreCase("000")) {
                System.out.println("Выход из программы.");
                break;
            }

            input = input.replaceAll("\\s+", "");

            try {
                int index = findOperatorIndex(input);
                if (index <= 0 || index == input.length() - 1) {
                    throw new IllegalArgumentException(
                        "Ввод должен содержать два числа и одну операцию (например, 2+3).");
                }

                int a = Integer.parseInt(input.substring(0, index));
                char operation = input.charAt(index);
                int b = Integer.parseInt(input.substring(index + 1));

                if (a < -10 || a > 10 || b < -10 || b > 10) {
                    throw new IllegalArgumentException("Числа должны быть в диапазоне от -10 до 10.");
                }

                int result;
                switch (operation) {
                    case '+': result = a + b; break;
                    case '-': result = a - b; break;
                    case '*': result = a * b; break;
                    case '/':
                        if (b == 0) throw new ArithmeticException("Делить на ноль нельзя!");
                        result = a / b;
                        break;
                    default:
                        throw new IllegalArgumentException(
                            "Неправильная операция. Используйте: +, -, *, /.");
                }

                System.out.println("Итого: " + result);
            } catch (NumberFormatException e) {
                System.out.println("Ошибка: вводите только целые числа.");
            } catch (IllegalArgumentException | ArithmeticException e) {
                System.out.println("Ошибка: " + e.getMessage());
            }
        }

        scanner.close();
    }

    /**
     * Ищет индекс оператора, пропуская ведущий минус (для отрицательных чисел).
     * Например: "-5+3" → индекс '+' = 2; "10*-2" → индекс '*' = 2.
     */
    private static int findOperatorIndex(String input) {
        int start = (input.startsWith("-") || input.startsWith("+")) ? 1 : 0;
        for (int i = start; i < input.length(); i++) {
            char ch = input.charAt(i);
            if (ch == '+' || ch == '-' || ch == '*' || ch == '/') {
                return i;
            }
        }
        return -1;
    }
}
